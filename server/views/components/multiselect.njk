{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{%- from "moj/components/badge/macro.njk" import mojBadge -%}

{% macro productRow(item, params) %}
    <tr class="govuk-table__row govuk-table__row--selected">        

    {% if not item.enabled %}
      <td class="govuk-table__cell">
          <div class="govuk-checkboxes__item govuk-checkboxes--small">
            <input type="checkbox" class="disabled-govuk-checkboxes__input"
                   id="{{ item.name }}"
                   name="{{ params.itemGroupName }}" value="{{ item.name }}" disabled>
            <label class="govuk-label govuk-checkboxes__label" for="{{ item.name }}">
              <span class="govuk-visually-hidden">Select {{ item.label }}</span>
            </label>
          </div>
      </td>
        <td class="govuk-table__cell"><span class='disabled-text'>{{item.label}}</span></td>
        {% set serviceStatusLabel = mojBadge({ text: "Disabled", classes: "moj-badge--grey"}) %}
        <td class="govuk-table__cell">{{ serviceStatusLabel }}</td>
    {% else %}
      <td class="govuk-table__cell">
          {% set isChecked = (item.enabled) and (params.selectedItems or []).indexOf(item.name) > -1 %}
          <div class="govuk-checkboxes__item govuk-checkboxes--small moj-multi-select__checkbox">
            <input type="checkbox" class="govuk-checkboxes__input govuk-moj-multi-select__checkbox__input"
                   id="{{ item.name }}"
                   name="{{ params.itemGroupName }}" value="{{ item.name }}"
                    {{- " checked" if isChecked }} >

            <label class="govuk-label govuk-checkboxes__label" for="{{ item.name }}">
              <span class="govuk-visually-hidden">Select {{ item.label }}</span>
            </label>
          </div>
      </td>
          <td class="govuk-table__cell">{{item.label}} </td>

          {% if item.suspended %}
            {% set serviceStatusLabel = mojBadge({ text: "Suspended", classes: "moj-badge--red" }) %}
          {% else %}
            {% set serviceStatusLabel = mojBadge({ text: "Active", classes: "moj-badge--green"}) %}
          {% endif %}

           <td class="govuk-table__cell">{{serviceStatusLabel}} </td>
        {% endif %}
    </tr>   
{% endmacro %}

{% macro multiSelect(params) %}

<table class="govuk-table product-selection-table" data-module="moj-multi-select" data-multi-select-checkbox="#select-all">
  <colgroup>
    <col class="product-selection-table__select">
    <col>
    <col class="product-selection-table__status">
  </colgroup>
  <thead class="govuk-table__head">
    <tr class="govuk-table__row">
      <th class="govuk-table__header" scope="col" id="select-all">Select all<br/></th>
      {% for item in params.headers %}
      <th class="govuk-table__header" scope="col">{{item}}</th>
       {% endfor %}
    </tr>
  </thead>
  <tbody class="govuk-table__body">
  {% for category in params.categorisedItems %}
    <tr><td colspan="3"><h4>{{ category.name | lower | capitalizeFirst }}</h4></td></tr>

    {% for item in category.items %}
    {{ productRow(item, params) }}
     {% endfor %}

  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro backlogSelect(params) %}
<table class="govuk-table product-selection-table backlog-products">
  <colgroup>
    <col class="product-selection-table__select">
    <col>
    <col class="product-selection-table__status">
  </colgroup>
  <tbody class="govuk-table__body">
    <tr><td colspan="3"><h4>Backlog</h4></td></tr>
  {% for item in params.items %}
    {{ productRow(item, params) }}
  {% endfor %}
  </tbody>
</table>
{% endmacro %}
