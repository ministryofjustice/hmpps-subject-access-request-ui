{% macro slackChannel(channelId) %}
  {% if channelId %}
    {% set channelIds = channelId | slackChannelIds %}
    {% if channelIds | length %}
      {% for id in channelIds %}{% if not loop.first %}, {% endif %}{% set channelUrl = slackChannelBaseUrl ~ (id | urlencode) %}<a class="govuk-link" href="{{ channelUrl }}" target="_blank" rel="noopener noreferrer">{{ id }}</a>{% endfor %}
    {% else %}
      NONE
    {% endif %}
  {% else %}
    NONE
  {% endif %}
{% endmacro %}
